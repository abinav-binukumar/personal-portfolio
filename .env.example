# Copy this file to .env and fill in your own EmailJS values, then
# `npm run deploy` (or `npm run build`) again so they get baked in.
#
# Every contact-form submission sends TWO emails, so you need TWO templates
# in EmailJS:
#
# 1. Create a free account at https://www.emailjs.com/
# 2. Add an Email Service (e.g. Gmail) -> copy its Service ID
# 3. Create an "auto-reply" template (sent to the visitor) - in the
#    template's "To email" field put {{to_email}}. Suggested content:
#
#      Subject: Thanks for reaching out, {{first_name}}!
#      Body:
#        Hi {{first_name}},
#
#        Thank you for reaching out - it was great hearing from you!
#        I'll take a look and get back to you soon. Let me know if you
#        need any further updates in the meantime.
#
#        Best,
#        Abinav
#
#    -> copy its Template ID into REACT_APP_EMAILJS_AUTOREPLY_TEMPLATE_ID
#
# 4. Create a second "notify me" template (sent to you) - in the
#    template's "To email" field put {{to_email}} too (it'll be filled
#    with your own address from the code, see REACT_APP_OWNER_EMAIL
#    below). Suggested content:
#
#      Subject: New portfolio contact: {{first_name}} {{last_name}}
#      Body:
#        {{first_name}} {{last_name}} ({{from_email}}) just reached out
#        through the portfolio contact game.
#
#        Message:
#        {{message}}
#
#    -> copy its Template ID into REACT_APP_EMAILJS_NOTIFY_TEMPLATE_ID
#
# 5. Account -> General -> copy your Public Key
#
# Without all of these set, the contact form just logs to the console
# instead of sending (see sendMessage in src/components/hero/HeroGame.tsx).

REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_AUTOREPLY_TEMPLATE_ID=
REACT_APP_EMAILJS_NOTIFY_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=

# Where the "someone contacted you" notification email should go.
# Defaults to abinav.binukumar@ontariotechu.net if left blank.
REACT_APP_OWNER_EMAIL=
